# Store and check out text files with LF line endings on every platform. This
# overrides `core.autocrlf=true` (the Git for Windows default), which would otherwise
# check files out with CRLF and make `vp check` report formatting errors.
* text=auto eol=lf

# Binary files: never convert line endings and never try to show a text diff.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary
*.zip binary
*.gz binary

# Generated by pnpm and Drizzle. Hide them from diffs and treat them as generated.
pnpm-lock.yaml -diff linguist-generated=true
db/migrations/meta/** -diff linguist-generated=true
